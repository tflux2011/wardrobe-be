# Backend
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
# Primary model (optional)
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview
# Optional comma-separated fallback order
GEMINI_IMAGE_MODELS=gemini-3.1-flash-image-preview,gemini-2.5-flash-image,gemini-3-pro-image-preview
# Used for full garment reconstruction from uploaded crops
OPENWEATHER_API_KEY=your_openweather_api_key_here
# Required for Firebase ID token verification on protected API routes
FIREBASE_WEB_API_KEY=your_firebase_web_api_key_here
PORT=3002
# Restrict CORS in production (e.g. your frontend domain)
ALLOWED_ORIGIN=*
# Optional global API rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
# Optional tighter rate limiting for AI stylist endpoint
STYLIST_RATE_LIMIT_WINDOW_MS=60000
STYLIST_RATE_LIMIT_MAX_REQUESTS=25

# Required to enable admin login; no default credentials are provided.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Photo-referenced mannequin previews (server only)
OPENAI_OUTFIT_IMAGE_MODEL=gpt-image-2

# Free beta allowances, enforced on the API using PostgreSQL reservations.
BETA_GARMENT_LIMIT=100
BETA_UPLOADS_LIMIT=20
BETA_VIEWS_LIMIT=5
BETA_TRIPS_LIMIT=3
BETA_STYLING_LIMIT=30
BETA_STORAGE_BYTES=104857600
# Hard daily platform work ceilings, including failed AI attempts.
DAILY_PLATFORM_IMAGE_LIMIT=200
DAILY_PLATFORM_TEXT_LIMIT=2000
DAILY_PLATFORM_UPLOAD_LIMIT=2000
# Optional dedicated random media-signing key. Defaults to a server-only storage-key-derived HMAC.
MEDIA_SIGNING_KEY=
# Render defaults to one trusted proxy hop; set explicitly if the topology differs.
TRUST_PROXY_HOPS=1
# Use an ignored, access-restricted folder for photo-reference migration backups.
SECURITY_BACKUP_DIR=

# Weather provider calls are server-side, cached, and capped per UTC day.
DAILY_PLATFORM_WEATHER_LIMIT=2000
